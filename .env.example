# HTTP server
HTTP_ADDR=:8090

# WATI AI Operator webhook auth (Authorization: Bearer <token>)
WEBHOOK_TOKEN=change-me-webhook-token

# WATI outbound API
WATI_BASE_URL=https://live-server.wati.io
WATI_TENANT_ID=
WATI_API_TOKEN=change-me
WATI_SOURCE_TYPE=API

# LLM — OpenAI-compatible /chat/completions
# OpenAI example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4.1-mini
#
# OpenCode Go example:
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_API_KEY=
# LLM_MODEL=glm-5.2
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT=120s

# Agent limits
MAX_STEPS=6
MAX_OUTPUT_TOKENS=2048
MAX_CONTEXT_TOKENS=8000
